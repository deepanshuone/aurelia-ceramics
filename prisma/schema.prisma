generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // Vercel functions run on Amazon Linux (rhel-openssl-3.0.x); always generate that engine too.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  // Staff roles for the admin panel (see lib/admin.ts):
  // EDITOR manages orders and the catalogue, VIEWER can only look.
  EDITOR
  VIEWER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  code           String           @unique
  description    String?
  specifications Json?
  // Product-page details; each is optional and only shown when filled in.
  // Free text so admins can write "26 cm × 9 cm" or "450 g" as they like.
  dimensions       String?
  weight           String?
  material         String?
  capacity         String?
  colour           String?
  finish           String?
  whatsIncluded    String?
  careInstructions String?
  // Null means "not specified" (nothing is shown).
  foodSafe         Boolean?
  microwaveSafe    Boolean?
  dishwasherSafe   Boolean?
  // False for items that can't be returned for a change of mind (damage is still covered).
  returnable       Boolean          @default(true)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  price          Decimal          @db.Decimal(10, 2)
  mrp            Decimal?         @db.Decimal(10, 2)
  stock          Int              @default(0)
  rating         Decimal?         @db.Decimal(3, 2)
  reviewCount    Int              @default(0)
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  variants       ProductVariant[]
  images         ProductImage[]
  inventory      Inventory?
  orderItems     OrderItem[]
  cartItems      CartItem[]
  reviews        Review[]
  wishlistedBy   Wishlist[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([createdAt])
}

model ProductVariant {
  id         String     @id @default(cuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String     @unique
  price      Decimal?   @db.Decimal(10, 2)
  stock      Int        @default(0)
  attributes Json?
  cartItems  CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Customer {
  id           String     @id @default(cuid())
  name         String
  phone        String
  phoneVerifiedAt DateTime?
  email        String     @unique
  passwordHash String?
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  reviews      Review[]
  wishlist     Wishlist[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([phone])
}

// One-time codes sent by SMS to verify a mobile number at sign-up.
// Only a hash of the code is stored.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  address    String
  city       String
  state      String
  pin        String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Cart {
  id           String     @id @default(cuid())
  customerId   String?    @unique
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique
  // Null for guest checkout: the order is reached through a signed link
  // (lib/order-access.ts) instead of an account.
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Random key the guest checkout page sends with its order, so a double
  // submit returns the first order instead of creating a second one.
  checkoutKey     String?     @unique
  items           OrderItem[]

  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @db.Decimal(10, 2) @default(0)
  delivery        Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)

  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])

  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(ONLINE)
  paymentStatus   PaymentStatus @default(PENDING)
  payment         Payment?

  shippingName    String?
  shippingPhone   String?
  shippingEmail   String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingPin     String?

  trackingCarrier String?
  trackingNumber  String?
  cancelReason    String?
  refundedAmount  Decimal     @db.Decimal(10, 2) @default(0)

  // Set once the customer's confirmation email has been sent (prevents duplicates).
  confirmationEmailSentAt DateTime?

  // When the order was confirmed (COD placed or online payment captured);
  // the processing time counts from here.
  confirmedAt     DateTime?
  // Processing time for this order only; null uses StoreSetting.processingDays.
  processingDays  Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive])
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean  @default(false)
  photos             ReviewPhoto[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
}

// Photos customers attach to their reviews. Stored in the database (resized in
// the browser first, so each is a few hundred KB) and served by
// /api/reviews/photos/[id].
model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

// Messages from the public contact form, handled in /admin/enquiries.
model Enquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  requirement String
  message     String
  status      EnquiryStatus @default(NEW)
  adminNote   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

// Store-wide settings, edited in /admin/settings. Always a single row (id "store").
model StoreSetting {
  id                    String   @id @default("store")
  // Default processing time, in days, for orders without their own value.
  processingDays        Int      @default(3)
  // Delivery pricing in whole rupees: orders below the threshold pay the fee.
  freeDeliveryThreshold Int      @default(999)
  deliveryFee           Int      @default(99)
  // What Editors and Viewers may see or change, per admin area (lib/permissions.ts).
  // Null means the built-in defaults.
  rolePermissions       Json?
  // Show sample star ratings on products that have no reviews yet (lib/sample-ratings.ts).
  showSampleRatings     Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}
